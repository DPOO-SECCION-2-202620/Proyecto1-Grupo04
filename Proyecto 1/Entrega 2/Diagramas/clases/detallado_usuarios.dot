digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Usuarios, turnos, entrenamiento y reportes"; labelloc=t; fontsize=14;
"Usuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Usuario</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ PORCENTAJE_PUNTOS: double</U><BR ALIGN="LEFT"/>- id: String<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- login: String<BR ALIGN="LEFT"/>- password: String<BR ALIGN="LEFT"/>- puntosFidelidad: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ autenticar(login: String, password: String): boolean<BR ALIGN="LEFT"/>+ acumularPuntos(valorCompra: double): void<BR ALIGN="LEFT"/>+ redimirPuntos(maximo: double): double<BR ALIGN="LEFT"/>+ puedeUsarInstalacionesYPartidos(): boolean<BR ALIGN="LEFT"/><I>+ getTipo(): String</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Socio" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Socio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fechaDeNacimiento: LocalDate<BR ALIGN="LEFT"/>- instalacionActual: Instalacion<BR ALIGN="LEFT"/>- tieneBebidaCaliente: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularEdad(): int<BR ALIGN="LEFT"/>+ calcularEdad(fechaReferencia: LocalDate): int<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/>+ tieneBebidaCaliente(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Empleado" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Empleado</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- turnos: List&lt;Turno&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarTurno(t: Turno): void<BR ALIGN="LEFT"/>+ estaDisponible(dia: String, hora: LocalTime): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Entrenador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Entrenador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- perfilJugador: Socio<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ planearSesion(idSesion, fechaHora, duracionMinutos, instalacion, convocados): SesionEntrenamiento<BR ALIGN="LEFT"/>+ registrarAsistenciaYEvaluacion(sesion, jugador, estado, nota, comentario): void<BR ALIGN="LEFT"/>+ registrarResultadoPartido(partido: Partido, marcadorA: int, marcadorB: int): void<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Fisioterapeuta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Fisioterapeuta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ consultarCargaFisica(jugador: Socio, todasLasSesiones: List&lt;SesionEntrenamiento&gt;): List&lt;SesionEntrenamiento&gt;<BR ALIGN="LEFT"/>+ calcularMinutosDeCarga(jugador: Socio, todasLasSesiones: List&lt;SesionEntrenamiento&gt;): int<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Administrador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Administrador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ MIN_ENTRENADORES: int</U><BR ALIGN="LEFT"/><U>+ MIN_FISIOTERAPEUTAS: int</U><BR ALIGN="LEFT"/><U>+ PASO_MINUTOS: int</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ puedeUsarInstalacionesYPartidos(): boolean<BR ALIGN="LEFT"/>+ crearEquipo(nombre, deporte, categoria, cupoMaximo): Equipo<BR ALIGN="LEFT"/>+ darDeBajaJugador(equipo: Equipo, jugador: Socio): void<BR ALIGN="LEFT"/>+ moverArticulo(articulo: Articulo, origen: String, destino: String, cantidad: int): void<BR ALIGN="LEFT"/>+ reabastecer(articulo: Articulo, ubicacion: String, cantidad: int): void<BR ALIGN="LEFT"/>+ aprobarCambioTurno(solicitud, empleados, diasAtencion, apertura, cierre): boolean<BR ALIGN="LEFT"/>+ generarReporteVentas(ventas: List&lt;Venta&gt;, rubro: String, inicio: LocalDate, fin: LocalDate): ReporteVentas<BR ALIGN="LEFT"/>+ generarReporteDeportivo(tipo, inicio, fin, sesiones, partidos, practicas, inscripciones): ReporteDeportivo<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Turno" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Turno</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dia: String<BR ALIGN="LEFT"/>- horaInicio: LocalTime<BR ALIGN="LEFT"/>- horaFin: LocalTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cubre(dia: String, hora: LocalTime): boolean<BR ALIGN="LEFT"/>+ mismoHorario(otro: Turno): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"SolicitudCambioTurno" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>SolicitudCambioTurno</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- empleado: Empleado<BR ALIGN="LEFT"/>- turnoActual: Turno<BR ALIGN="LEFT"/>- turnoPropuesto: Turno<BR ALIGN="LEFT"/>- estado: EstadoSolicitud<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aprobar(): void<BR ALIGN="LEFT"/>+ rechazar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"SesionEntrenamiento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>SesionEntrenamiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- fechaHora: LocalDateTime<BR ALIGN="LEFT"/>- duracion: int<BR ALIGN="LEFT"/>- entrenador: Entrenador<BR ALIGN="LEFT"/>- instalacion: Instalacion<BR ALIGN="LEFT"/>- convocados: List&lt;Socio&gt;<BR ALIGN="LEFT"/>- asistencias: List&lt;AsistenciaEvaluacion&gt;<BR ALIGN="LEFT"/>- finalizada: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ finalizar(): void<BR ALIGN="LEFT"/>+ registrarAsistencia(jugador, estado, nota, comentario): void<BR ALIGN="LEFT"/>+ agregarAsistenciaCargada(a: AsistenciaEvaluacion): void<BR ALIGN="LEFT"/>+ buscarAsistencia(jugador: Socio): AsistenciaEvaluacion<BR ALIGN="LEFT"/>+ getFin(): LocalDateTime<BR ALIGN="LEFT"/>+ seCruzaCon(inicio: LocalDateTime, minutos: int): boolean<BR ALIGN="LEFT"/>+ calcularPorcentajeAsistencia(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"AsistenciaEvaluacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>AsistenciaEvaluacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jugador: Socio<BR ALIGN="LEFT"/>- estado: EstadoAsistencia<BR ALIGN="LEFT"/>- nota: int<BR ALIGN="LEFT"/>- comentario: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tieneEvaluacion(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Reporte" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Reporte</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- periodoInicio: LocalDate<BR ALIGN="LEFT"/>- periodoFin: LocalDate<BR ALIGN="LEFT"/>- fechaGeneracion: LocalDate<BR ALIGN="LEFT"/># contenido: StringBuilder<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ generar(): void</I><BR ALIGN="LEFT"/># marcarGenerado(): void<BR ALIGN="LEFT"/>+ enPeriodo(f: LocalDate): boolean<BR ALIGN="LEFT"/><U>+ calcularPeriodo(tipoPeriodo: String, referencia: LocalDate): LocalDate[]</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"ReporteVentas" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ReporteVentas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- rubro: String<BR ALIGN="LEFT"/>- totalPorRubro: double<BR ALIGN="LEFT"/>- ventas: List&lt;Venta&gt;<BR ALIGN="LEFT"/>- totales: Map&lt;String, Double&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularTotalPorRubro(): double<BR ALIGN="LEFT"/>+ generar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"ReporteDeportivo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ReporteDeportivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tipo: String<BR ALIGN="LEFT"/>- sesiones: List&lt;SesionEntrenamiento&gt;<BR ALIGN="LEFT"/>- partidos: List&lt;Partido&gt;<BR ALIGN="LEFT"/>- partidosPractica: List&lt;PartidoPractica&gt;<BR ALIGN="LEFT"/>- inscripciones: List&lt;InscripcionDisciplina&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularEstadisticas(): void<BR ALIGN="LEFT"/>+ generar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"CodigoDescuento" [shape=box, style="dashed,filled", fillcolor="#F7EAF5", label="CodigoDescuento", fontsize=9];
"EstadisticaPartido" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="EstadisticaPartido", fontsize=9];
"EstadisticaPractica" [shape=box, style="dashed,filled", fillcolor="#FFF4E0", label="EstadisticaPractica", fontsize=9];
"InscripcionCompetencia" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="InscripcionCompetencia", fontsize=9];
"InscripcionDisciplina" [shape=box, style="dashed,filled", fillcolor="#FFF4E0", label="InscripcionDisciplina", fontsize=9];
"InscripcionEquipo" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="InscripcionEquipo", fontsize=9];
"Instalacion" [shape=box, style="dashed,filled", fillcolor="#FFF4E0", label="Instalacion", fontsize=9];
"Partido" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="Partido", fontsize=9];
"PartidoPractica" [shape=box, style="dashed,filled", fillcolor="#FFF4E0", label="PartidoPractica", fontsize=9];
"Reserva" [shape=box, style="dashed,filled", fillcolor="#FFF4E0", label="Reserva", fontsize=9];
"Sugerencia" [shape=box, style="dashed,filled", fillcolor="#F7EAF5", label="Sugerencia", fontsize=9];
"Venta" [shape=box, style="dashed,filled", fillcolor="#F7EAF5", label="Venta", fontsize=9];
"Socio" -> "Usuario" [arrowhead=empty, arrowsize=1.1];
"Empleado" -> "Usuario" [arrowhead=empty, arrowsize=1.1];
"Administrador" -> "Usuario" [arrowhead=empty, arrowsize=1.1];
"Entrenador" -> "Empleado" [arrowhead=empty, arrowsize=1.1];
"Fisioterapeuta" -> "Empleado" [arrowhead=empty, arrowsize=1.1];
"Empleado" -> "Turno" [dir=both, arrowtail=diamond, arrowhead=none, label="turnos", taillabel="1", headlabel="0..*"];
"Entrenador" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="perfilJugador", taillabel="0..1", headlabel="0..1"];
"Socio" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalacionActual", taillabel="0..*", headlabel="0..1"];
"SolicitudCambioTurno" -> "Empleado" [arrowhead=vee, arrowsize=0.7, label="empleado", taillabel="0..*", headlabel="1"];
"SolicitudCambioTurno" -> "Turno" [arrowhead=vee, arrowsize=0.7, label="turnoActual / turnoPropuesto", taillabel="0..*", headlabel="2"];
"SesionEntrenamiento" -> "Entrenador" [arrowhead=vee, arrowsize=0.7, label="entrenador", taillabel="0..*", headlabel="1"];
"SesionEntrenamiento" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalacion", taillabel="0..*", headlabel="0..1"];
"SesionEntrenamiento" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="convocados", taillabel="0..*", headlabel="1..*"];
"SesionEntrenamiento" -> "AsistenciaEvaluacion" [dir=both, arrowtail=diamond, arrowhead=none, label="asistencias", taillabel="1", headlabel="0..*"];
"AsistenciaEvaluacion" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"ReporteVentas" -> "Reporte" [arrowhead=empty, arrowsize=1.1];
"ReporteDeportivo" -> "Reporte" [arrowhead=empty, arrowsize=1.1];
"ReporteVentas" -> "Venta" [arrowhead=vee, arrowsize=0.7, label="ventas", taillabel="0..*", headlabel="0..*"];
"ReporteDeportivo" -> "SesionEntrenamiento" [arrowhead=vee, arrowsize=0.7, label="sesiones", taillabel="0..*", headlabel="0..*"];
"ReporteDeportivo" -> "Partido" [arrowhead=vee, arrowsize=0.7, label="partidos", taillabel="0..*", headlabel="0..*"];
"ReporteDeportivo" -> "PartidoPractica" [arrowhead=vee, arrowsize=0.7, label="partidosPractica", taillabel="0..*", headlabel="0..*"];
"ReporteDeportivo" -> "InscripcionDisciplina" [arrowhead=vee, arrowsize=0.7, label="inscripciones", taillabel="0..*", headlabel="0..*"];
"Administrador" -> "SolicitudCambioTurno" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="revisa"];
"Administrador" -> "ReporteVentas" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="genera"];
"Administrador" -> "ReporteDeportivo" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="genera"];
"Entrenador" -> "SesionEntrenamiento" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="planea"];
"Fisioterapeuta" -> "SesionEntrenamiento" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="consulta carga"];
"InscripcionEquipo" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"EstadisticaPartido" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"InscripcionCompetencia" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="nomina / amarillas / suspendidos", taillabel="0..*", headlabel="1..*"];
"Reserva" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="socioResponsable", taillabel="0..*", headlabel="1"];
"InscripcionDisciplina" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="socio", taillabel="0..*", headlabel="1"];
"EstadisticaPractica" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"Venta" -> "Usuario" [arrowhead=vee, arrowsize=0.7, label="comprador", taillabel="0..*", headlabel="1"];
"CodigoDescuento" -> "Empleado" [arrowhead=vee, arrowsize=0.7, label="dueno", taillabel="0..1", headlabel="1"];
"Sugerencia" -> "Empleado" [arrowhead=vee, arrowsize=0.7, label="autor", taillabel="0..*", headlabel="1"];
"ClubDeportivo" -> "Usuario" [arrowhead=vee, arrowsize=0.7, label="usuarios", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "SesionEntrenamiento" [arrowhead=vee, arrowsize=0.7, label="sesiones", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "SolicitudCambioTurno" [arrowhead=vee, arrowsize=0.7, label="solicitudesTurno", taillabel="1", headlabel="0..*"];
subgraph cluster_enums { label="Enumeraciones usadas"; style=dashed; fontsize=10;
"Disciplina" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Disciplina</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">TENIS<BR ALIGN="LEFT"/>PADEL<BR ALIGN="LEFT"/>TENIS_MESA<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
"EstadoAsistencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoAsistencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ASISTIO<BR ALIGN="LEFT"/>FALTO<BR ALIGN="LEFT"/>TARDE<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
"EstadoSolicitud" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoSolicitud</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDIENTE<BR ALIGN="LEFT"/>APROBADA<BR ALIGN="LEFT"/>RECHAZADA<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
}
}