digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Alto nivel — Equipos, partidos y competencias"; labelloc=t; fontsize=14;
"Equipo" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>Equipo</B>>, fontsize=11, margin="0.15,0.08"];
"InscripcionEquipo" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>InscripcionEquipo</B>>, fontsize=11, margin="0.15,0.08"];
"Partido" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<I><B>Partido</B></I>>, fontsize=11, margin="0.15,0.08"];
"PartidoInterno" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>PartidoInterno</B>>, fontsize=11, margin="0.15,0.08"];
"PartidoCompetencia" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>PartidoCompetencia</B>>, fontsize=11, margin="0.15,0.08"];
"EstadisticaPartido" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<I><B>EstadisticaPartido</B></I>>, fontsize=11, margin="0.15,0.08"];
"EstadisticaFutbol" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>EstadisticaFutbol</B>>, fontsize=11, margin="0.15,0.08"];
"EstadisticaBaloncesto" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>EstadisticaBaloncesto</B>>, fontsize=11, margin="0.15,0.08"];
"EstadisticaVoleibol" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>EstadisticaVoleibol</B>>, fontsize=11, margin="0.15,0.08"];
"Competencia" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<I><B>Competencia</B></I>>, fontsize=11, margin="0.15,0.08"];
"CompetenciaLiga" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>CompetenciaLiga</B>>, fontsize=11, margin="0.15,0.08"];
"CompetenciaFases" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>CompetenciaFases</B>>, fontsize=11, margin="0.15,0.08"];
"InscripcionCompetencia" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>InscripcionCompetencia</B>>, fontsize=11, margin="0.15,0.08"];
"Fase" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>Fase</B>>, fontsize=11, margin="0.15,0.08"];
"Grupo" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>Grupo</B>>, fontsize=11, margin="0.15,0.08"];
"PosicionTabla" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>PosicionTabla</B>>, fontsize=11, margin="0.15,0.08"];
"Enfrentamiento" [shape=box, style=filled, fillcolor="#EAF6EC", label=<<B>Enfrentamiento</B>>, fontsize=11, margin="0.15,0.08"];
"Administrador" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Administrador", fontsize=9];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"Entrenador" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Entrenador", fontsize=9];
"ReporteDeportivo" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="ReporteDeportivo", fontsize=9];
"Socio" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Socio", fontsize=9];
"ReporteDeportivo" -> "Partido" [arrowhead=vee, arrowsize=0.7, label="partidos", taillabel="0..*", headlabel="0..*"];
"Administrador" -> "Equipo" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="crea"];
"Entrenador" -> "Partido" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="registra resultado"];
"Equipo" -> "InscripcionEquipo" [dir=both, arrowtail=diamond, arrowhead=none, label="inscripciones", taillabel="1", headlabel="0..*"];
"InscripcionEquipo" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"PartidoInterno" -> "Partido" [arrowhead=empty, arrowsize=1.1];
"PartidoCompetencia" -> "Partido" [arrowhead=empty, arrowsize=1.1];
"Partido" -> "EstadisticaPartido" [dir=both, arrowtail=diamond, arrowhead=none, label="estadisticas", taillabel="1", headlabel="0..*"];
"EstadisticaFutbol" -> "EstadisticaPartido" [arrowhead=empty, arrowsize=1.1];
"EstadisticaBaloncesto" -> "EstadisticaPartido" [arrowhead=empty, arrowsize=1.1];
"EstadisticaVoleibol" -> "EstadisticaPartido" [arrowhead=empty, arrowsize=1.1];
"EstadisticaPartido" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"PartidoInterno" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipoLocal / equipoVisitante", taillabel="0..*", headlabel="2"];
"PartidoCompetencia" -> "InscripcionCompetencia" [arrowhead=vee, arrowsize=0.7, label="inscripcion", taillabel="0..*", headlabel="1"];
"PartidoCompetencia" -> "Enfrentamiento" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="comoEnfrentamiento"];
"CompetenciaLiga" -> "Competencia" [arrowhead=empty, arrowsize=1.1];
"CompetenciaFases" -> "Competencia" [arrowhead=empty, arrowsize=1.1];
"Competencia" -> "InscripcionCompetencia" [dir=both, arrowtail=diamond, arrowhead=none, label="inscripciones", taillabel="1", headlabel="0..*"];
"Competencia" -> "PartidoCompetencia" [dir=both, arrowtail=diamond, arrowhead=none, label="partidos", taillabel="1", headlabel="0..*"];
"Competencia" -> "Enfrentamiento" [dir=both, arrowtail=diamond, arrowhead=none, label="resultadosExternos", taillabel="1", headlabel="0..*"];
"InscripcionCompetencia" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipo", taillabel="0..*", headlabel="1"];
"InscripcionCompetencia" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="nomina / amarillas / suspendidos", taillabel="0..*", headlabel="1..*"];
"CompetenciaLiga" -> "PosicionTabla" [dir=both, arrowtail=diamond, arrowhead=none, label="tabla", taillabel="1", headlabel="0..*"];
"CompetenciaFases" -> "Fase" [dir=both, arrowtail=diamond, arrowhead=none, label="fases", taillabel="1", headlabel="1..*"];
"Fase" -> "Grupo" [dir=both, arrowtail=diamond, arrowhead=none, label="grupos", taillabel="1", headlabel="0..*"];
"Grupo" -> "PosicionTabla" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="calcularTabla"];
"Fase" -> "Enfrentamiento" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="usa"];
"ClubDeportivo" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipos", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "PartidoInterno" [arrowhead=vee, arrowsize=0.7, label="partidosInternos", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "Competencia" [arrowhead=vee, arrowsize=0.7, label="competencias", taillabel="1", headlabel="0..*"];
}