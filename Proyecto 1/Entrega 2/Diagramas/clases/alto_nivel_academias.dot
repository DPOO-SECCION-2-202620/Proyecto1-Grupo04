digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Alto nivel — Academias individuales e instalaciones"; labelloc=t; fontsize=14;
"Instalacion" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<I><B>Instalacion</B></I>>, fontsize=11, margin="0.15,0.08"];
"CanchaTenis" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>CanchaTenis</B>>, fontsize=11, margin="0.15,0.08"];
"CanchaPadel" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>CanchaPadel</B>>, fontsize=11, margin="0.15,0.08"];
"MesaDeTenisMesa" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>MesaDeTenisMesa</B>>, fontsize=11, margin="0.15,0.08"];
"Reserva" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>Reserva</B>>, fontsize=11, margin="0.15,0.08"];
"InscripcionDisciplina" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>InscripcionDisciplina</B>>, fontsize=11, margin="0.15,0.08"];
"PartidoPractica" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>PartidoPractica</B>>, fontsize=11, margin="0.15,0.08"];
"EstadisticaPractica" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<I><B>EstadisticaPractica</B></I>>, fontsize=11, margin="0.15,0.08"];
"EstadisticaTenisPadel" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>EstadisticaTenisPadel</B>>, fontsize=11, margin="0.15,0.08"];
"EstadisticaTenisMesa" [shape=box, style=filled, fillcolor="#FFF4E0", label=<<B>EstadisticaTenisMesa</B>>, fontsize=11, margin="0.15,0.08"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"ReporteDeportivo" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="ReporteDeportivo", fontsize=9];
"SesionEntrenamiento" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="SesionEntrenamiento", fontsize=9];
"Socio" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Socio", fontsize=9];
"Socio" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalacionActual", taillabel="0..*", headlabel="0..1"];
"SesionEntrenamiento" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalacion", taillabel="0..*", headlabel="0..1"];
"ReporteDeportivo" -> "PartidoPractica" [arrowhead=vee, arrowsize=0.7, label="partidosPractica", taillabel="0..*", headlabel="0..*"];
"ReporteDeportivo" -> "InscripcionDisciplina" [arrowhead=vee, arrowsize=0.7, label="inscripciones", taillabel="0..*", headlabel="0..*"];
"CanchaTenis" -> "Instalacion" [arrowhead=empty, arrowsize=1.1];
"CanchaPadel" -> "Instalacion" [arrowhead=empty, arrowsize=1.1];
"MesaDeTenisMesa" -> "Instalacion" [arrowhead=empty, arrowsize=1.1];
"Instalacion" -> "Reserva" [dir=both, arrowtail=diamond, arrowhead=none, label="reservas", taillabel="1", headlabel="0..*"];
"Reserva" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="socioResponsable", taillabel="0..*", headlabel="1"];
"InscripcionDisciplina" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="socio", taillabel="0..*", headlabel="1"];
"InscripcionDisciplina" -> "PartidoPractica" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="programa"];
"PartidoPractica" -> "InscripcionDisciplina" [arrowhead=vee, arrowsize=0.7, label="jugadores", taillabel="0..*", headlabel="2 o 4"];
"PartidoPractica" -> "EstadisticaPractica" [dir=both, arrowtail=diamond, arrowhead=none, label="estadisticas", taillabel="1", headlabel="0..*"];
"EstadisticaTenisPadel" -> "EstadisticaPractica" [arrowhead=empty, arrowsize=1.1];
"EstadisticaTenisMesa" -> "EstadisticaPractica" [arrowhead=empty, arrowsize=1.1];
"EstadisticaPractica" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"ClubDeportivo" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalaciones", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "InscripcionDisciplina" [arrowhead=vee, arrowsize=0.7, label="inscripcionesDisciplina", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "PartidoPractica" [arrowhead=vee, arrowsize=0.7, label="partidosPractica", taillabel="1", headlabel="0..*"];
}