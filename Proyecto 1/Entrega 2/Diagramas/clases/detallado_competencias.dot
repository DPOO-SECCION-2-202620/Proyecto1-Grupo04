digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Competencias externas"; labelloc=t; fontsize=14;
"Competencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Competencia</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- entidadOrganizadora: String<BR ALIGN="LEFT"/>- temporada: String<BR ALIGN="LEFT"/>- deporte: Deporte<BR ALIGN="LEFT"/>- categoria: Categoria<BR ALIGN="LEFT"/>- nominaMinima: int<BR ALIGN="LEFT"/>- inscripciones: List&lt;InscripcionCompetencia&gt;<BR ALIGN="LEFT"/>- partidos: List&lt;PartidoCompetencia&gt;<BR ALIGN="LEFT"/>- resultadosExternos: List&lt;Enfrentamiento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ inscribirEquipo(equipo: Equipo, nomina: List&lt;Socio&gt;): InscripcionCompetencia<BR ALIGN="LEFT"/>+ agregarInscripcionCargada(i: InscripcionCompetencia): void<BR ALIGN="LEFT"/>+ buscarInscripcion(equipo: Equipo): InscripcionCompetencia<BR ALIGN="LEFT"/>+ agregarPartido(p: PartidoCompetencia): void<BR ALIGN="LEFT"/>+ registrarResultadoExterno(e: Enfrentamiento): void<BR ALIGN="LEFT"/>+ getEnfrentamientosJugados(): List&lt;Enfrentamiento&gt;<BR ALIGN="LEFT"/>+ getNombresEquipos(): List&lt;String&gt;<BR ALIGN="LEFT"/><U># agregarSinRepetir(lista: List&lt;String&gt;, valor: String): void</U><BR ALIGN="LEFT"/>+ calcularTablaGoleadores(): List&lt;Entry&lt;Socio, Integer&gt;&gt;<BR ALIGN="LEFT"/>+ calcularJugadorMasDestacado(): Socio<BR ALIGN="LEFT"/><I>+ getFormato(): String</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"CompetenciaLiga" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>CompetenciaLiga</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tabla: List&lt;PosicionTabla&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPuntos(): void<BR ALIGN="LEFT"/>+ calcularTablaPosiciones(): List&lt;PosicionTabla&gt;<BR ALIGN="LEFT"/>+ getFormato(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"CompetenciaFases" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>CompetenciaFases</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fases: List&lt;Fase&gt;<BR ALIGN="LEFT"/>- indiceFaseActual: int<BR ALIGN="LEFT"/>- campeon: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarFase(f: Fase): void<BR ALIGN="LEFT"/>+ getFaseActual(): Fase<BR ALIGN="LEFT"/>+ getNombreFaseActual(): String<BR ALIGN="LEFT"/>+ calcularClasificados(): List&lt;String&gt;<BR ALIGN="LEFT"/>+ avanzarFase(): void<BR ALIGN="LEFT"/>+ getFormato(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"InscripcionCompetencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>InscripcionCompetencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- competencia: Competencia<BR ALIGN="LEFT"/>- equipo: Equipo<BR ALIGN="LEFT"/>- nomina: List&lt;Socio&gt;<BR ALIGN="LEFT"/>- amarillasAcumuladas: Map&lt;Socio, Integer&gt;<BR ALIGN="LEFT"/>- suspendidos: Set&lt;Socio&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ estaEnNomina(s: Socio): boolean<BR ALIGN="LEFT"/>+ estaHabilitado(s: Socio): boolean<BR ALIGN="LEFT"/>+ getHabilitados(): List&lt;Socio&gt;<BR ALIGN="LEFT"/>+ tieneMinimoHabilitados(): boolean<BR ALIGN="LEFT"/>+ actualizarSanciones(estadisticas: List&lt;EstadisticaPartido&gt;): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"Fase" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Fase</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- tipo: TipoFase<BR ALIGN="LEFT"/>- grupos: List&lt;Grupo&gt;<BR ALIGN="LEFT"/>- participantes: List&lt;String&gt;<BR ALIGN="LEFT"/>- clasificadosPorGrupo: int<BR ALIGN="LEFT"/>- finalizada: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarGrupo(g: Grupo): void<BR ALIGN="LEFT"/>+ calcularClasificados(enfrentamientosDeLaFase: List&lt;Enfrentamiento&gt;, deporte: Deporte): List&lt;String&gt;<BR ALIGN="LEFT"/>+ avanzar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"Grupo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Grupo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- equipos: List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularTabla(enfrentamientosDeLaFase: List&lt;Enfrentamiento&gt;, deporte: Deporte): List&lt;PosicionTabla&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"PosicionTabla" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>PosicionTabla</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombreEquipo: String<BR ALIGN="LEFT"/>- puntos: int<BR ALIGN="LEFT"/>- victorias: int<BR ALIGN="LEFT"/>- empates: int<BR ALIGN="LEFT"/>- derrotas: int<BR ALIGN="LEFT"/>- golesFavor: int<BR ALIGN="LEFT"/>- golesContra: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrarResultado(favor: int, contra: int, deporte: Deporte): void<BR ALIGN="LEFT"/><U>+ construirTabla(equipos, enfrentamientos, deporte, desempateDirecto): List&lt;PosicionTabla&gt;</U><BR ALIGN="LEFT"/>+ getDiferencia(): int<BR ALIGN="LEFT"/>+ getPartidosJugados(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"Enfrentamiento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Enfrentamiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- equipoA: String<BR ALIGN="LEFT"/>- equipoB: String<BR ALIGN="LEFT"/>- golesA: int<BR ALIGN="LEFT"/>- golesB: int<BR ALIGN="LEFT"/>- fase: String<BR ALIGN="LEFT"/>- grupo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getGanador(): String<BR ALIGN="LEFT"/>+ esEntre(x: String, y: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"Equipo" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="Equipo", fontsize=9];
"PartidoCompetencia" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="PartidoCompetencia", fontsize=9];
"Socio" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Socio", fontsize=9];
"PartidoCompetencia" -> "InscripcionCompetencia" [arrowhead=vee, arrowsize=0.7, label="inscripcion", taillabel="0..*", headlabel="1"];
"CompetenciaLiga" -> "Competencia" [arrowhead=empty, arrowsize=1.1];
"CompetenciaFases" -> "Competencia" [arrowhead=empty, arrowsize=1.1];
"Competencia" -> "InscripcionCompetencia" [dir=both, arrowtail=diamond, arrowhead=none, label="inscripciones", taillabel="1", headlabel="0..*"];
"Competencia" -> "PartidoCompetencia" [dir=both, arrowtail=diamond, arrowhead=none, label="partidos", taillabel="1", headlabel="0..*"];
"Competencia" -> "Enfrentamiento" [dir=both, arrowtail=diamond, arrowhead=none, label="resultadosExternos", taillabel="1", headlabel="0..*"];
"InscripcionCompetencia" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipo", taillabel="0..*", headlabel="1"];
"InscripcionCompetencia" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="nomina / amarillas / suspendidos", taillabel="0..*", headlabel="1..*"];
"CompetenciaLiga" -> "PosicionTabla" [dir=both, arrowtail=diamond, arrowhead=none, label="tabla", taillabel="1", headlabel="0..*"];
"CompetenciaFases" -> "Fase" [dir=both, arrowtail=diamond, arrowhead=none, label="fases", taillabel="1", headlabel="1..*"];
"Fase" -> "Grupo" [dir=both, arrowtail=diamond, arrowhead=none, label="grupos", taillabel="1", headlabel="0..*"];
"Grupo" -> "PosicionTabla" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="calcularTabla"];
"Fase" -> "Enfrentamiento" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="usa"];
"ClubDeportivo" -> "Competencia" [arrowhead=vee, arrowsize=0.7, label="competencias", taillabel="1", headlabel="0..*"];
subgraph cluster_enums { label="Enumeraciones usadas"; style=dashed; fontsize=10;
"Categoria" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Categoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SUB13(0, 12)<BR ALIGN="LEFT"/>SUB15(13, 14)<BR ALIGN="LEFT"/>SUB17(15, 16)<BR ALIGN="LEFT"/>MAYORES(17, ∞)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- edadMinima: int<BR ALIGN="LEFT"/>- edadMaxima: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ admiteEdad(edad: int): boolean<BR ALIGN="LEFT"/><U>+ paraEdad(edad: int): Categoria</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
"Deporte" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Deporte</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FUTBOL(7, true)<BR ALIGN="LEFT"/>BALONCESTO(5, false)<BR ALIGN="LEFT"/>VOLEIBOL(6, false)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- minimoJugadores: int<BR ALIGN="LEFT"/>- permiteEmpate: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ permiteEmpate(): boolean<BR ALIGN="LEFT"/>+ puntosVictoria(): int<BR ALIGN="LEFT"/>+ puntosEmpate(): int<BR ALIGN="LEFT"/>+ puntosDerrota(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
"TipoFase" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoFase</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">GRUPOS<BR ALIGN="LEFT"/>ELIMINACION<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
}
}