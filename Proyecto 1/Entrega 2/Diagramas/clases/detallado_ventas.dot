digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Tienda, cafetería y ventas"; labelloc=t; fontsize=14;
"Venta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Venta</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/>- comprador: Usuario<BR ALIGN="LEFT"/>- subtotal: double<BR ALIGN="LEFT"/>- descuento: double<BR ALIGN="LEFT"/>- puntosRedimidos: double<BR ALIGN="LEFT"/>- impuesto: double<BR ALIGN="LEFT"/>- total: double<BR ALIGN="LEFT"/>- puntosFidelidadGenerados: double<BR ALIGN="LEFT"/>- cerrada: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I># calcularSubtotal(): double</I><BR ALIGN="LEFT"/><I>+ getTasaImpuesto(): double</I><BR ALIGN="LEFT"/><I>+ getRubro(): String</I><BR ALIGN="LEFT"/># calcularDescuento(): double<BR ALIGN="LEFT"/># calcularAdicional(): double<BR ALIGN="LEFT"/># permiteRedimirPuntos(): boolean<BR ALIGN="LEFT"/># validarAntesDeCerrar(): void<BR ALIGN="LEFT"/># alCerrar(): void<BR ALIGN="LEFT"/>+ calcularTotal(): double<BR ALIGN="LEFT"/>+ usarPuntosFidelidad(): void<BR ALIGN="LEFT"/>+ cerrar(): void<BR ALIGN="LEFT"/>+ fijarValoresCargados(subtotal, descuento, puntosRedimidos, impuesto, total, puntos, cerrada): void<BR ALIGN="LEFT"/>+ generarDetalle(): String<BR ALIGN="LEFT"/>+ getAdicional(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"VentaTienda" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>VentaTienda</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ IVA: double</U><BR ALIGN="LEFT"/>- items: List&lt;ItemVentaTienda&gt;<BR ALIGN="LEFT"/>- descuentoAplicado: CodigoDescuento<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarItem(articulo: Articulo, cantidad: int): void<BR ALIGN="LEFT"/>+ aplicarDescuento(codigo: CodigoDescuento): void<BR ALIGN="LEFT"/>+ agregarItemCargado(i: ItemVentaTienda): void<BR ALIGN="LEFT"/># calcularSubtotal(): double<BR ALIGN="LEFT"/># calcularDescuento(): double<BR ALIGN="LEFT"/># permiteRedimirPuntos(): boolean<BR ALIGN="LEFT"/># validarAntesDeCerrar(): void<BR ALIGN="LEFT"/># alCerrar(): void<BR ALIGN="LEFT"/>+ getTasaImpuesto(): double<BR ALIGN="LEFT"/>+ getRubro(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"VentaCafeteria" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>VentaCafeteria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ IMPUESTO_CONSUMO: double</U><BR ALIGN="LEFT"/><U>+ PROPINA_SUGERIDA: double</U><BR ALIGN="LEFT"/>- items: List&lt;ItemVentaCafeteria&gt;<BR ALIGN="LEFT"/>- propina: double<BR ALIGN="LEFT"/>- propinaAjustada: boolean<BR ALIGN="LEFT"/>- alergenosInformados: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarItem(producto: ProductoCafeteria, cantidad: int): void<BR ALIGN="LEFT"/>+ informarAlergenos(): String<BR ALIGN="LEFT"/>+ ajustarPropina(nuevaPropina: double): void<BR ALIGN="LEFT"/>+ contieneBebidaCaliente(): boolean<BR ALIGN="LEFT"/>+ agregarItemCargado(i: ItemVentaCafeteria): void<BR ALIGN="LEFT"/>+ fijarPropinaCargada(p: double): void<BR ALIGN="LEFT"/># calcularSubtotal(): double<BR ALIGN="LEFT"/># calcularAdicional(): double<BR ALIGN="LEFT"/>+ getAdicional(): double<BR ALIGN="LEFT"/># validarAntesDeCerrar(): void<BR ALIGN="LEFT"/># alCerrar(): void<BR ALIGN="LEFT"/>+ getTasaImpuesto(): double<BR ALIGN="LEFT"/>+ getRubro(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"VentaMensualidad" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>VentaMensualidad</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- periodo: String<BR ALIGN="LEFT"/>- valor: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># calcularSubtotal(): double<BR ALIGN="LEFT"/>+ getTasaImpuesto(): double<BR ALIGN="LEFT"/>+ getRubro(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"ItemVentaTienda" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ItemVentaTienda</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- articulo: Articulo<BR ALIGN="LEFT"/>- cantidad: int<BR ALIGN="LEFT"/>- precioUnitario: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularSubtotal(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"ItemVentaCafeteria" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ItemVentaCafeteria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- producto: ProductoCafeteria<BR ALIGN="LEFT"/>- cantidad: int<BR ALIGN="LEFT"/>- precioUnitario: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularSubtotal(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"Articulo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Articulo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TIENDA: String</U><BR ALIGN="LEFT"/><U>+ BODEGA: String</U><BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- categoria: String<BR ALIGN="LEFT"/>- precio: double<BR ALIGN="LEFT"/>- inventario: List&lt;InventarioUbicacion&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hayInventarioSuficiente(cantidad: int): boolean<BR ALIGN="LEFT"/>+ getCantidadEn(ubicacion: String): int<BR ALIGN="LEFT"/>+ getCantidadTotal(): int<BR ALIGN="LEFT"/>+ agregarInventario(ubicacion: String, cantidad: int): void<BR ALIGN="LEFT"/>+ retirarInventario(ubicacion: String, cantidad: int): void<BR ALIGN="LEFT"/>+ buscarUbicacion(ubicacion: String): InventarioUbicacion<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"InventarioUbicacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>InventarioUbicacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ubicacion: String<BR ALIGN="LEFT"/>- cantidad: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregar(n: int): void<BR ALIGN="LEFT"/>+ retirar(n: int): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"CodigoDescuento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>CodigoDescuento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigo: String<BR ALIGN="LEFT"/>- dueno: Empleado<BR ALIGN="LEFT"/>- porcentajeEmpleado: double<BR ALIGN="LEFT"/>- porcentajeSocio: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPorcentaje(comprador: Usuario): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"ProductoCafeteria" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>ProductoCafeteria</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- precio: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getTipo(): String</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"Bebida" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Bebida</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tipo: TipoBebida<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ esCaliente(): boolean<BR ALIGN="LEFT"/>+ getTipoBebida(): TipoBebida<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"Snack" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Snack</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- alergenos: List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tieneAlergenos(): boolean<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"Sugerencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Sugerencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ ARTICULO: String</U><BR ALIGN="LEFT"/><U>+ SNACK: String</U><BR ALIGN="LEFT"/>- id: int<BR ALIGN="LEFT"/>- autor: Empleado<BR ALIGN="LEFT"/>- tipoProducto: String<BR ALIGN="LEFT"/>- nombreProducto: String<BR ALIGN="LEFT"/>- categoria: String<BR ALIGN="LEFT"/>- precioSugerido: double<BR ALIGN="LEFT"/>- estado: EstadoSugerencia<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aprobar(): void<BR ALIGN="LEFT"/>+ rechazar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"Empleado" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Empleado", fontsize=9];
"ReporteVentas" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="ReporteVentas", fontsize=9];
"Usuario" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Usuario", fontsize=9];
"ReporteVentas" -> "Venta" [arrowhead=vee, arrowsize=0.7, label="ventas", taillabel="0..*", headlabel="0..*"];
"VentaTienda" -> "Venta" [arrowhead=empty, arrowsize=1.1];
"VentaCafeteria" -> "Venta" [arrowhead=empty, arrowsize=1.1];
"VentaMensualidad" -> "Venta" [arrowhead=empty, arrowsize=1.1];
"Venta" -> "Usuario" [arrowhead=vee, arrowsize=0.7, label="comprador", taillabel="0..*", headlabel="1"];
"VentaTienda" -> "ItemVentaTienda" [dir=both, arrowtail=diamond, arrowhead=none, label="items", taillabel="1", headlabel="1..*"];
"VentaCafeteria" -> "ItemVentaCafeteria" [dir=both, arrowtail=diamond, arrowhead=none, label="items", taillabel="1", headlabel="1..*"];
"VentaTienda" -> "CodigoDescuento" [arrowhead=vee, arrowsize=0.7, label="descuentoAplicado", taillabel="0..*", headlabel="0..1"];
"ItemVentaTienda" -> "Articulo" [arrowhead=vee, arrowsize=0.7, label="articulo", taillabel="0..*", headlabel="1"];
"ItemVentaCafeteria" -> "ProductoCafeteria" [arrowhead=vee, arrowsize=0.7, label="producto", taillabel="0..*", headlabel="1"];
"Articulo" -> "InventarioUbicacion" [dir=both, arrowtail=diamond, arrowhead=none, label="inventario", taillabel="1", headlabel="0..*"];
"CodigoDescuento" -> "Empleado" [arrowhead=vee, arrowsize=0.7, label="dueno", taillabel="0..1", headlabel="1"];
"Sugerencia" -> "Empleado" [arrowhead=vee, arrowsize=0.7, label="autor", taillabel="0..*", headlabel="1"];
"Bebida" -> "ProductoCafeteria" [arrowhead=empty, arrowsize=1.1];
"Snack" -> "ProductoCafeteria" [arrowhead=empty, arrowsize=1.1];
"ClubDeportivo" -> "Articulo" [arrowhead=vee, arrowsize=0.7, label="articulos", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "ProductoCafeteria" [arrowhead=vee, arrowsize=0.7, label="productosCafeteria", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "CodigoDescuento" [arrowhead=vee, arrowsize=0.7, label="codigosDescuento", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "Venta" [arrowhead=vee, arrowsize=0.7, label="ventas", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "Sugerencia" [arrowhead=vee, arrowsize=0.7, label="sugerencias", taillabel="1", headlabel="0..*"];
subgraph cluster_enums { label="Enumeraciones usadas"; style=dashed; fontsize=10;
"EstadoSugerencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoSugerencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDIENTE<BR ALIGN="LEFT"/>APROBADA<BR ALIGN="LEFT"/>RECHAZADA<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
"TipoBebida" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoBebida</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FRIA<BR ALIGN="LEFT"/>CALIENTE<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
}
}