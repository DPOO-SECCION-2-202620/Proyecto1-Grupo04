digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Academias individuales e instalaciones"; labelloc=t; fontsize=14;
"Instalacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Instalacion</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ SENCILLOS: String</U><BR ALIGN="LEFT"/><U>+ DOBLES: String</U><BR ALIGN="LEFT"/>- id: String<BR ALIGN="LEFT"/>- capacidadMaxima: int<BR ALIGN="LEFT"/>- reservas: List&lt;Reserva&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getDisciplina(): Disciplina</I><BR ALIGN="LEFT"/><I>+ admiteJugadores(cantidad: int, modalidad: String): boolean</I><BR ALIGN="LEFT"/><I>+ getTipo(): String</I><BR ALIGN="LEFT"/>+ permiteBebidaCaliente(): boolean<BR ALIGN="LEFT"/>+ estaOcupada(inicio: LocalDateTime): boolean<BR ALIGN="LEFT"/>+ reservar(idReserva, socio, fechaHora, cantidadJugadores, modalidad): Reserva<BR ALIGN="LEFT"/>+ agregarReservaCargada(r: Reserva): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"CanchaTenis" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>CanchaTenis</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDisciplina(): Disciplina<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/>+ admiteJugadores(cantidad: int, modalidad: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"CanchaPadel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>CanchaPadel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDisciplina(): Disciplina<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/>+ permiteBebidaCaliente(): boolean<BR ALIGN="LEFT"/>+ admiteJugadores(cantidad: int, modalidad: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"MesaDeTenisMesa" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>MesaDeTenisMesa</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- techada: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDisciplina(): Disciplina<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/>+ permiteBebidaCaliente(): boolean<BR ALIGN="LEFT"/>+ admiteJugadores(cantidad: int, modalidad: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"Reserva" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Reserva</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ DURACION_BLOQUE_MINUTOS: int</U><BR ALIGN="LEFT"/>- id: int<BR ALIGN="LEFT"/>- instalacion: Instalacion<BR ALIGN="LEFT"/>- socioResponsable: Socio<BR ALIGN="LEFT"/>- fechaHora: LocalDateTime<BR ALIGN="LEFT"/>- cantidadJugadores: int<BR ALIGN="LEFT"/>- modalidad: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getFin(): LocalDateTime<BR ALIGN="LEFT"/>+ seCruzaCon(inicio: LocalDateTime): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"InscripcionDisciplina" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>InscripcionDisciplina</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ ELO_INICIAL: double</U><BR ALIGN="LEFT"/>- socio: Socio<BR ALIGN="LEFT"/>- disciplina: Disciplina<BR ALIGN="LEFT"/>- nivel: Nivel<BR ALIGN="LEFT"/>- rankingElo: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ programarPartidoPractica(idPartido, otrosJugadores, fecha, incluyeEntrenador): PartidoPractica<BR ALIGN="LEFT"/>+ actualizarElo(delta: double): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"PartidoPractica" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>PartidoPractica</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ K_ELO: double</U><BR ALIGN="LEFT"/>- id: int<BR ALIGN="LEFT"/>- disciplina: Disciplina<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/>- jugadores: List&lt;InscripcionDisciplina&gt;<BR ALIGN="LEFT"/>- estadisticas: List&lt;EstadisticaPractica&gt;<BR ALIGN="LEFT"/>- jugado: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getLadoA(): List&lt;InscripcionDisciplina&gt;<BR ALIGN="LEFT"/>+ getLadoB(): List&lt;InscripcionDisciplina&gt;<BR ALIGN="LEFT"/>+ registrarResultado(stats: List&lt;EstadisticaPractica&gt;): void<BR ALIGN="LEFT"/>+ buscarInscripcion(s: Socio): InscripcionDisciplina<BR ALIGN="LEFT"/>+ getGanadores(): List&lt;Socio&gt;<BR ALIGN="LEFT"/>+ cargarResultado(stats: List&lt;EstadisticaPractica&gt;): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"EstadisticaPractica" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>EstadisticaPractica</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jugador: Socio<BR ALIGN="LEFT"/>- eloAntes: double<BR ALIGN="LEFT"/>- eloDespues: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getSetsGanados(): int</I><BR ALIGN="LEFT"/><I>+ correspondeA(d: Disciplina): boolean</I><BR ALIGN="LEFT"/><I>+ describir(): String</I><BR ALIGN="LEFT"/>+ setElo(antes: double, despues: double): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"EstadisticaTenisPadel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EstadisticaTenisPadel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- setsGanados: int<BR ALIGN="LEFT"/>- gamesGanados: int<BR ALIGN="LEFT"/>- aces: int<BR ALIGN="LEFT"/>- erroresNoForzados: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ correspondeA(d: Disciplina): boolean<BR ALIGN="LEFT"/>+ describir(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"EstadisticaTenisMesa" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EstadisticaTenisMesa</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- setsGanados: int<BR ALIGN="LEFT"/>- puntosTotales: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ correspondeA(d: Disciplina): boolean<BR ALIGN="LEFT"/>+ describir(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"ReporteDeportivo" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="ReporteDeportivo", fontsize=9];
"SesionEntrenamiento" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="SesionEntrenamiento", fontsize=9];
"Socio" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Socio", fontsize=9];
"Socio" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalacionActual", taillabel="0..*", headlabel="0..1"];
"SesionEntrenamiento" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalacion", taillabel="0..*", headlabel="0..1"];
"ReporteDeportivo" -> "PartidoPractica" [arrowhead=vee, arrowsize=0.7, label="partidosPractica", taillabel="0..*", headlabel="0..*"];
"ReporteDeportivo" -> "InscripcionDisciplina" [arrowhead=vee, arrowsize=0.7, label="inscripciones", taillabel="0..*", headlabel="0..*"];
"CanchaTenis" -> "Instalacion" [arrowhead=empty, arrowsize=1.1];
"CanchaPadel" -> "Instalacion" [arrowhead=empty, arrowsize=1.1];
"MesaDeTenisMesa" -> "Instalacion" [arrowhead=empty, arrowsize=1.1];
"Instalacion" -> "Reserva" [dir=both, arrowtail=diamond, arrowhead=none, label="reservas", taillabel="1", headlabel="0..*"];
"Reserva" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="socioResponsable", taillabel="0..*", headlabel="1"];
"InscripcionDisciplina" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="socio", taillabel="0..*", headlabel="1"];
"InscripcionDisciplina" -> "PartidoPractica" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="programa"];
"PartidoPractica" -> "InscripcionDisciplina" [arrowhead=vee, arrowsize=0.7, label="jugadores", taillabel="0..*", headlabel="2 o 4"];
"PartidoPractica" -> "EstadisticaPractica" [dir=both, arrowtail=diamond, arrowhead=none, label="estadisticas", taillabel="1", headlabel="0..*"];
"EstadisticaTenisPadel" -> "EstadisticaPractica" [arrowhead=empty, arrowsize=1.1];
"EstadisticaTenisMesa" -> "EstadisticaPractica" [arrowhead=empty, arrowsize=1.1];
"EstadisticaPractica" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"ClubDeportivo" -> "Instalacion" [arrowhead=vee, arrowsize=0.7, label="instalaciones", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "InscripcionDisciplina" [arrowhead=vee, arrowsize=0.7, label="inscripcionesDisciplina", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "PartidoPractica" [arrowhead=vee, arrowsize=0.7, label="partidosPractica", taillabel="1", headlabel="0..*"];
subgraph cluster_enums { label="Enumeraciones usadas"; style=dashed; fontsize=10;
"Disciplina" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Disciplina</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">TENIS<BR ALIGN="LEFT"/>PADEL<BR ALIGN="LEFT"/>TENIS_MESA<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
"Nivel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Nivel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PRINCIPIANTE<BR ALIGN="LEFT"/>INTERMEDIO<BR ALIGN="LEFT"/>AVANZADO<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ esCompatibleCon(otro: Nivel): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
}
}