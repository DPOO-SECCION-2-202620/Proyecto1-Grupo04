digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Equipos y partidos de conjunto"; labelloc=t; fontsize=14;
"Equipo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Equipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- deporte: Deporte<BR ALIGN="LEFT"/>- categoria: Categoria<BR ALIGN="LEFT"/>- cupoMaximo: int<BR ALIGN="LEFT"/>- inscripciones: List&lt;InscripcionEquipo&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ inscribirJugador(jugador, posicion, numeroCamiseta, fechaReferencia): InscripcionEquipo<BR ALIGN="LEFT"/>+ agregarInscripcionCargada(i: InscripcionEquipo): void<BR ALIGN="LEFT"/>+ darDeBaja(jugador: Socio): void<BR ALIGN="LEFT"/>+ buscarInscripcionActiva(jugador: Socio): InscripcionEquipo<BR ALIGN="LEFT"/>+ contarActivos(): int<BR ALIGN="LEFT"/>+ getJugadoresActivos(): List&lt;Socio&gt;<BR ALIGN="LEFT"/>+ getJugadoresHabilitados(): List&lt;Socio&gt;<BR ALIGN="LEFT"/>+ estaHabilitado(jugador: Socio): boolean<BR ALIGN="LEFT"/>+ tieneMinimoJugadoresHabilitados(): boolean<BR ALIGN="LEFT"/>+ actualizarSuspensiones(estadisticasDelPartido: List&lt;EstadisticaPartido&gt;): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"InscripcionEquipo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>InscripcionEquipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- equipo: Equipo<BR ALIGN="LEFT"/>- jugador: Socio<BR ALIGN="LEFT"/>- posicion: String<BR ALIGN="LEFT"/>- numeroCamiseta: int<BR ALIGN="LEFT"/>- activo: boolean<BR ALIGN="LEFT"/>- suspendidoProximoPartido: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ estaHabilitado(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"Partido" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Partido</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/>- deporte: Deporte<BR ALIGN="LEFT"/>- marcadorA: int<BR ALIGN="LEFT"/>- marcadorB: int<BR ALIGN="LEFT"/>- jugado: boolean<BR ALIGN="LEFT"/>- estadisticas: List&lt;EstadisticaPartido&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ puedeJugarse(): boolean</I><BR ALIGN="LEFT"/><I># jugadorPuedeParticipar(jugador: Socio): boolean</I><BR ALIGN="LEFT"/><I># alFinalizar(): void</I><BR ALIGN="LEFT"/><I>+ getNombreA(): String</I><BR ALIGN="LEFT"/><I>+ getNombreB(): String</I><BR ALIGN="LEFT"/><I>+ getTipo(): String</I><BR ALIGN="LEFT"/>+ registrarEstadisticas(e: EstadisticaPartido): void<BR ALIGN="LEFT"/>+ agregarEstadisticaCargada(e: EstadisticaPartido): void<BR ALIGN="LEFT"/>+ registrarResultado(marcadorA: int, marcadorB: int): void<BR ALIGN="LEFT"/>+ fijarResultadoCargado(a: int, b: int, jugado: boolean): void<BR ALIGN="LEFT"/>+ buscarEstadistica(jugador: Socio): EstadisticaPartido<BR ALIGN="LEFT"/>+ getMarcador(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"PartidoInterno" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>PartidoInterno</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- equipoLocal: Equipo<BR ALIGN="LEFT"/>- equipoVisitante: Equipo<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ puedeJugarse(): boolean<BR ALIGN="LEFT"/># jugadorPuedeParticipar(jugador: Socio): boolean<BR ALIGN="LEFT"/># alFinalizar(): void<BR ALIGN="LEFT"/>+ involucraA(e: Equipo): boolean<BR ALIGN="LEFT"/>+ getNombreA(): String<BR ALIGN="LEFT"/>+ getNombreB(): String<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"PartidoCompetencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>PartidoCompetencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- inscripcion: InscripcionCompetencia<BR ALIGN="LEFT"/>- institucionRival: String<BR ALIGN="LEFT"/>- escenario: String<BR ALIGN="LEFT"/>- fase: String<BR ALIGN="LEFT"/>- grupo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ puedeJugarse(): boolean<BR ALIGN="LEFT"/># jugadorPuedeParticipar(jugador: Socio): boolean<BR ALIGN="LEFT"/># alFinalizar(): void<BR ALIGN="LEFT"/>+ comoEnfrentamiento(): Enfrentamiento<BR ALIGN="LEFT"/>+ getNombreA(): String<BR ALIGN="LEFT"/>+ getNombreB(): String<BR ALIGN="LEFT"/>+ getTipo(): String<BR ALIGN="LEFT"/>+ getCompetencia(): Competencia<BR ALIGN="LEFT"/>+ getEquipo(): Equipo<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"EstadisticaPartido" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>EstadisticaPartido</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jugador: Socio<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getDeporte(): Deporte</I><BR ALIGN="LEFT"/><I>+ getValorPrincipal(): int</I><BR ALIGN="LEFT"/><I>+ calcularValoracion(): double</I><BR ALIGN="LEFT"/><I>+ describir(): String</I><BR ALIGN="LEFT"/>+ quedaSuspendido(): boolean<BR ALIGN="LEFT"/>+ getAmarillas(): int<BR ALIGN="LEFT"/>+ tieneRoja(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"EstadisticaFutbol" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EstadisticaFutbol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- goles: int<BR ALIGN="LEFT"/>- asistencias: int<BR ALIGN="LEFT"/>- amarillas: int<BR ALIGN="LEFT"/>- rojas: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ quedaSuspendido(): boolean<BR ALIGN="LEFT"/>+ getDeporte(): Deporte<BR ALIGN="LEFT"/>+ getValorPrincipal(): int<BR ALIGN="LEFT"/>+ tieneRoja(): boolean<BR ALIGN="LEFT"/>+ calcularValoracion(): double<BR ALIGN="LEFT"/>+ describir(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"EstadisticaBaloncesto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EstadisticaBaloncesto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- puntos: int<BR ALIGN="LEFT"/>- rebotes: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDeporte(): Deporte<BR ALIGN="LEFT"/>+ getValorPrincipal(): int<BR ALIGN="LEFT"/>+ calcularValoracion(): double<BR ALIGN="LEFT"/>+ describir(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"EstadisticaVoleibol" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EstadisticaVoleibol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- aces: int<BR ALIGN="LEFT"/>- bloqueos: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDeporte(): Deporte<BR ALIGN="LEFT"/>+ getValorPrincipal(): int<BR ALIGN="LEFT"/>+ calcularValoracion(): double<BR ALIGN="LEFT"/>+ describir(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"Competencia" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="Competencia", fontsize=9];
"InscripcionCompetencia" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="InscripcionCompetencia", fontsize=9];
"ReporteDeportivo" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="ReporteDeportivo", fontsize=9];
"Socio" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Socio", fontsize=9];
"ReporteDeportivo" -> "Partido" [arrowhead=vee, arrowsize=0.7, label="partidos", taillabel="0..*", headlabel="0..*"];
"Equipo" -> "InscripcionEquipo" [dir=both, arrowtail=diamond, arrowhead=none, label="inscripciones", taillabel="1", headlabel="0..*"];
"InscripcionEquipo" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"PartidoInterno" -> "Partido" [arrowhead=empty, arrowsize=1.1];
"PartidoCompetencia" -> "Partido" [arrowhead=empty, arrowsize=1.1];
"Partido" -> "EstadisticaPartido" [dir=both, arrowtail=diamond, arrowhead=none, label="estadisticas", taillabel="1", headlabel="0..*"];
"EstadisticaFutbol" -> "EstadisticaPartido" [arrowhead=empty, arrowsize=1.1];
"EstadisticaBaloncesto" -> "EstadisticaPartido" [arrowhead=empty, arrowsize=1.1];
"EstadisticaVoleibol" -> "EstadisticaPartido" [arrowhead=empty, arrowsize=1.1];
"EstadisticaPartido" -> "Socio" [arrowhead=vee, arrowsize=0.7, label="jugador", taillabel="0..*", headlabel="1"];
"PartidoInterno" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipoLocal / equipoVisitante", taillabel="0..*", headlabel="2"];
"PartidoCompetencia" -> "InscripcionCompetencia" [arrowhead=vee, arrowsize=0.7, label="inscripcion", taillabel="0..*", headlabel="1"];
"Competencia" -> "PartidoCompetencia" [dir=both, arrowtail=diamond, arrowhead=none, label="partidos", taillabel="1", headlabel="0..*"];
"InscripcionCompetencia" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipo", taillabel="0..*", headlabel="1"];
"ClubDeportivo" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipos", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "PartidoInterno" [arrowhead=vee, arrowsize=0.7, label="partidosInternos", taillabel="1", headlabel="0..*"];
subgraph cluster_enums { label="Enumeraciones usadas"; style=dashed; fontsize=10;
"Categoria" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Categoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SUB13(0, 12)<BR ALIGN="LEFT"/>SUB15(13, 14)<BR ALIGN="LEFT"/>SUB17(15, 16)<BR ALIGN="LEFT"/>MAYORES(17, ∞)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- edadMinima: int<BR ALIGN="LEFT"/>- edadMaxima: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ admiteEdad(edad: int): boolean<BR ALIGN="LEFT"/><U>+ paraEdad(edad: int): Categoria</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
"Deporte" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Deporte</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FUTBOL(7, true)<BR ALIGN="LEFT"/>BALONCESTO(5, false)<BR ALIGN="LEFT"/>VOLEIBOL(6, false)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- minimoJugadores: int<BR ALIGN="LEFT"/>- permiteEmpate: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ permiteEmpate(): boolean<BR ALIGN="LEFT"/>+ puntosVictoria(): int<BR ALIGN="LEFT"/>+ puntosEmpate(): int<BR ALIGN="LEFT"/>+ puntosDerrota(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FAFAFA"];
}
}