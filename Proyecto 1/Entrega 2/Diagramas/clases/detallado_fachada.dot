label="Fachada, persistencia, excepción y consolas"; labelloc=t; fontsize=14;
"ClubDeportivo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ClubDeportivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- diasAtencion: List&lt;String&gt;<BR ALIGN="LEFT"/>- horaApertura: LocalTime<BR ALIGN="LEFT"/>- horaCierre: LocalTime<BR ALIGN="LEFT"/>- maxInstalacionesSimultaneas: Map&lt;Disciplina, Integer&gt;<BR ALIGN="LEFT"/>- contadores: Map&lt;String, Integer&gt;<BR ALIGN="LEFT"/>- usuarios: List&lt;Usuario&gt;<BR ALIGN="LEFT"/>- equipos: List&lt;Equipo&gt;<BR ALIGN="LEFT"/>- partidosInternos: List&lt;PartidoInterno&gt;<BR ALIGN="LEFT"/>- competencias: List&lt;Competencia&gt;<BR ALIGN="LEFT"/>- instalaciones: List&lt;Instalacion&gt;<BR ALIGN="LEFT"/>- inscripcionesDisciplina: List&lt;InscripcionDisciplina&gt;<BR ALIGN="LEFT"/>- partidosPractica: List&lt;PartidoPractica&gt;<BR ALIGN="LEFT"/>- sesiones: List&lt;SesionEntrenamiento&gt;<BR ALIGN="LEFT"/>- solicitudesTurno: List&lt;SolicitudCambioTurno&gt;<BR ALIGN="LEFT"/>- articulos: List&lt;Articulo&gt;<BR ALIGN="LEFT"/>- productosCafeteria: List&lt;ProductoCafeteria&gt;<BR ALIGN="LEFT"/>- codigosDescuento: List&lt;CodigoDescuento&gt;<BR ALIGN="LEFT"/>- ventas: List&lt;Venta&gt;<BR ALIGN="LEFT"/>- sugerencias: List&lt;Sugerencia&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ proximoId(tipo: String): int<BR ALIGN="LEFT"/>+ siguienteId(tipo: String): int<BR ALIGN="LEFT"/>+ registrarUsuario(u: Usuario): void<BR ALIGN="LEFT"/>+ autenticar(login: String, password: String): Usuario<BR ALIGN="LEFT"/>+ buscarUsuario(id: String): Usuario<BR ALIGN="LEFT"/>+ buscarSocio(id: String): Socio<BR ALIGN="LEFT"/>+ getEmpleados(): List&lt;Empleado&gt;<BR ALIGN="LEFT"/>+ esTambienEntrenador(s: Socio): boolean<BR ALIGN="LEFT"/>+ buscarCodigoDeEmpleado(e: Empleado): CodigoDescuento<BR ALIGN="LEFT"/>+ buscarCodigo(codigo: String): CodigoDescuento<BR ALIGN="LEFT"/>+ crearEquipo(admin, nombre, deporte, categoria, cupo): Equipo<BR ALIGN="LEFT"/>+ darDeBajaEquipo(admin: Administrador, nombre: String): void<BR ALIGN="LEFT"/>+ buscarEquipo(nombre: String): Equipo<BR ALIGN="LEFT"/>+ buscarEquipoONull(nombre: String): Equipo<BR ALIGN="LEFT"/>+ inscribirJugadorEnEquipo(socio, nombreEquipo, posicion, camiseta, fechaReferencia): void<BR ALIGN="LEFT"/>+ darDeBajaJugador(admin: Administrador, nombreEquipo: String, socio: Socio): void<BR ALIGN="LEFT"/>+ darDeBajaJugadorDelClub(admin: Administrador, socio: Socio): int<BR ALIGN="LEFT"/>+ programarPartidoInterno(fecha: LocalDate, local: String, visitante: String): PartidoInterno<BR ALIGN="LEFT"/>+ buscarPartido(id: int): Partido<BR ALIGN="LEFT"/>+ getTodosLosPartidos(): List&lt;Partido&gt;<BR ALIGN="LEFT"/>+ registrarCompetencia(c: Competencia): void<BR ALIGN="LEFT"/>+ buscarCompetencia(nombre: String): Competencia<BR ALIGN="LEFT"/>+ inscribirEquipoEnCompetencia(competencia: String, equipo: String, nomina: List&lt;Socio&gt;): InscripcionCompetencia<BR ALIGN="LEFT"/>+ programarPartidoCompetencia(competencia, equipo, rival, escenario, fecha, fase, grupo): PartidoCompetencia<BR ALIGN="LEFT"/>+ registrarResultadoExterno(competencia, equipoA, equipoB, golesA, golesB, fase, grupo): void<BR ALIGN="LEFT"/>+ agregarInstalacion(i: Instalacion): void<BR ALIGN="LEFT"/>+ buscarInstalacion(id: String): Instalacion<BR ALIGN="LEFT"/>+ buscarInstalacionONull(id: String): Instalacion<BR ALIGN="LEFT"/>+ inscribirEnDisciplina(socio: Socio, disciplina: Disciplina, nivel: Nivel): InscripcionDisciplina<BR ALIGN="LEFT"/>+ buscarInscripcionDisciplina(s: Socio, d: Disciplina): InscripcionDisciplina<BR ALIGN="LEFT"/>+ reservar(solicitante, idInstalacion, fechaHora, cantidad, modalidad): Reserva<BR ALIGN="LEFT"/>+ entrarAInstalacion(socio: Socio, idInstalacion: String): void<BR ALIGN="LEFT"/>+ salirDeInstalacion(socio: Socio): void<BR ALIGN="LEFT"/>+ terminarBebidaCaliente(socio: Socio): void<BR ALIGN="LEFT"/>+ programarPartidoPractica(solicitante, disciplina, jugadores, fecha): PartidoPractica<BR ALIGN="LEFT"/>+ registrarResultadoPractica(idPartido: int, stats: List&lt;EstadisticaPractica&gt;): void<BR ALIGN="LEFT"/>+ buscarPartidoPractica(id: int): PartidoPractica<BR ALIGN="LEFT"/>+ planearSesion(entrenador, fechaHora, duracion, idInstalacion, convocados): SesionEntrenamiento<BR ALIGN="LEFT"/>+ planearSesionEquipo(entrenador, fechaHora, duracion, nombreEquipo): SesionEntrenamiento<BR ALIGN="LEFT"/>+ buscarSesion(id: int): SesionEntrenamiento<BR ALIGN="LEFT"/>+ solicitarCambioTurno(empleado: Empleado, actual: Turno, propuesto: Turno): SolicitudCambioTurno<BR ALIGN="LEFT"/>+ aprobarCambioTurno(admin: Administrador, s: SolicitudCambioTurno): boolean<BR ALIGN="LEFT"/>+ verificarCobertura(): String<BR ALIGN="LEFT"/>+ agregarArticulo(a: Articulo): void<BR ALIGN="LEFT"/>+ buscarArticulo(nombre: String): Articulo<BR ALIGN="LEFT"/>+ buscarArticuloONull(nombre: String): Articulo<BR ALIGN="LEFT"/>+ agregarProductoCafeteria(p: ProductoCafeteria): void<BR ALIGN="LEFT"/>+ buscarProducto(nombre: String): ProductoCafeteria<BR ALIGN="LEFT"/>+ buscarProductoONull(nombre: String): ProductoCafeteria<BR ALIGN="LEFT"/>+ iniciarVentaTienda(comprador: Usuario, fecha: LocalDate): VentaTienda<BR ALIGN="LEFT"/>+ iniciarVentaCafeteria(comprador: Usuario, fecha: LocalDate): VentaCafeteria<BR ALIGN="LEFT"/>+ confirmarVenta(v: Venta): void<BR ALIGN="LEFT"/>+ pagarMensualidad(socio: Socio, periodo: String, valor: double, fecha: LocalDate): VentaMensualidad<BR ALIGN="LEFT"/>+ moverArticulo(admin, articulo, origen, destino, cantidad): void<BR ALIGN="LEFT"/>+ reabastecer(admin, articulo, ubicacion, cantidad): void<BR ALIGN="LEFT"/>+ sugerirProducto(autor, tipo, nombre, categoriaOAlergenos, precio, fecha): Sugerencia<BR ALIGN="LEFT"/>+ aprobarSugerencia(admin: Administrador, idSugerencia: int): void<BR ALIGN="LEFT"/>+ rechazarSugerencia(admin: Administrador, idSugerencia: int): void<BR ALIGN="LEFT"/>+ buscarSugerencia(id: int): Sugerencia<BR ALIGN="LEFT"/>+ generarEstadoInventario(): String<BR ALIGN="L